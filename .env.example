# Copy this file to .env.local and fill in the values below.
# The first two are required; the last two are optional (AI drafting).

# The single password you type on the /login screen.
# It is ALSO used as the secret that signs your login cookie — so if you
# change it later, everyone gets logged out (which is what you want).
# Pick something long and random.
DASHBOARD_PASSWORD=change-me-to-a-long-random-password

# A GitHub fine-grained Personal Access Token (PAT) with READ + WRITE access
# to the ApagPlayz/content-generation-platform repository. It needs the
# Contents, Issues, Pull requests, and Actions permissions.
# Create one at: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxx

# OPTIONAL — turns on "Draft with AI" on the Process Map (asking Claude to
# rewrite agent instructions or reshape the whole loop for you). Without it,
# everything else still works: the AI boxes just show a note explaining how
# to switch them on. Create a key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# OPTIONAL — which Claude model the AI drafting uses. Leave this alone unless
# you have a reason to change it; the default is a good, fast choice.
# DASHBOARD_AI_MODEL=claude-sonnet-5
